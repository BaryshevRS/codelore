        "dependencies": {
          "body": "Использует localeBundle из src/markdown/locales.ts для получения локализованного набора строк callouts.",
          "rendered": true,
          "fingerprint": "deps=4ec07f51086b593056c44f29880666dea17dd81a252c8d8bf6bf7b02813f4a1c",
