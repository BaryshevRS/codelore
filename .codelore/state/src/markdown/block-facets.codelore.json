            "novelFact": "Не проверяет валидность blockId — опирается на BLOCK_FACETS, который гарантирует наличие фасетов."
          }
        },
        "dependencies": {
          "body": "",
          "rendered": false,
          "fingerprint": "deps=348df03cf22f9d11b167214eb17c19bc041d14494c4b0b5cf1897d55d6499362"
