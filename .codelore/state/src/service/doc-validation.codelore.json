          "fingerprint": "signature=a8759250d8beab56797003206ad21692591ca9d9231fc0e402095c7c7577083a,deps=71e73e05cabf9458e34c6b6d1d84d7d287543b0b192604f6a9be97e06d56f661,usage=067a62bb3797481992a4cae543c99d229529074ca9ddcbbe698ef4db7a55f5c9",
