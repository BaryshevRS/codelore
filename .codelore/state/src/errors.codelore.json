      "blocks": {
        "purpose": {
          "body": "Единый формат ошибок с машинно-читаемым кодом для всех компонентов Codelore.",
          "rendered": true,
          "fingerprint": "signature=d6ac165641bdee7c306b70556db9f5c4897a48cfa0d431a34899a9131f77dd80,placement=db2664b7eba43d9867f9022b812f4583b52c7b89b0697cc16a7fd3de528fe364",
