            "specificity": 0.75,
            "novelFact": "Первый `JSON.parse` защищает от ложного repair: repair применяется только при ошибке."
          }
        },
        "dependencies": {
          "body": "CodeloreError (src/errors.ts) — единый формат ошибок с машинно-читаемым кодом для всех компонентов Codelore.",
          "rendered": true,
          "fingerprint": "deps=d32447c520c4aba58eb01969fe8018724de9226a7f88e5a15fbde71c73bf2ca8",
          "scores": {
