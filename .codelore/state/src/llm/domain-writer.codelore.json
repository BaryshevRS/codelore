      "blocks": {
        "purpose": {
          "body": "Функция создает структуру запроса для LLM: принимает объект домена и возвращает объект с полем `instruction`, содержащим текстовую инструкцию. Инструкция формируется на основе шаблона, в который подставляется JSON-представление домена.",
          "rendered": true,
          "language": "ru",
          "scores": {
            "informativeness": 0.75,
            "novelty": 0.75,
            "specificity": 0.75,
            "novelFact": "Функция формирует запрос к LLM для генерации описания домена."
