          "fingerprint": "signature=2cdff57564e8f88d4d06f11cbfaaf4586adbab1fb35083338ac9f87eb1c591f3,placement=f08bb7927b6aeb86f90e8726725e65d1d63ab932caed609a43d730446f619218"
