          "language": "ru"
        },
        "limitations": {
          "body": "Не обрабатывает динамические импорты и рефлексию — статический анализ ts-morph ограничен синтаксическим деревом. Не проверяет корректность переданных records или entities.",
          "rendered": true,
          "fingerprint": "body=2413396c953a85a667c7c6541125cb1c4057b3b39a20921c84c5cd598f323d3e",
          "scores": {
            "informativeness": 0.5,
            "novelty": 0.5,
            "specificity": 0.75,
            "novelFact": "Статический анализ не обнаруживает динамические импорты."
