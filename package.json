{
  "name": "@codelore/mcp",
  "version": "1.0.0",
  "description": "MCP server for incremental living Markdown documentation tied to TypeScript and JavaScript code.",
  "keywords": [
    "documentation",
    "docs",
    "mcp",
    "model-context-protocol",
    "llm",
    "typescript",
    "javascript",
    "ast",
    "ts-morph",
    "code-documentation",
    "documentation-generator",
    "ai",
    "coding-agents",
    "stale-docs"
  ],
  "license": "MIT",
  "author": "Ruslan Baryshev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaryshevRS/codelore.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.1.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codelore": "./dist/bin/codelore.js",
    "codelore-mcp": "./dist/bin/codelore-mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "context:bundle": "repomix --style markdown --output codelore-context.md --include \"src/**/*.ts,package.json,README.md,AGENTS.md,CLAUDE.md,tsconfig*.json,biome.json,knip.json\" --ignore \"dist/**,node_modules/**,coverage/**,.git/**,*.codelore.md,.codelore/state/**,**/*.test.ts,**/.DS_Store\"",
    "dev": "tsx src/bin/codelore.ts mcp",
    "dev:cli": "tsx src/bin/codelore.ts",
    "lint": "pnpm run check:fix && pnpm run lint:knip && pnpm run check-types && pnpm run pmd:cpd && pnpm --filter @codelore/site run check-types",
    "lint:knip": "knip",
    "check-types": "tsc -p tsconfig.typecheck.json --noEmit",
    "pmd:cpd": "find src -name '*.ts' ! -name '*.test.ts' > .pmd-files.tmp && pnpm exec pmd cpd --minimum-tokens 70 --language typescript --file-list .pmd-files.tmp --format text --skip-lexical-errors; rm -f .pmd-files.tmp",
    "prepublishOnly": "pnpm run pretest",
    "pretest": "pnpm run typecheck && pnpm run build && pnpm --filter @codelore/site run pretest",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vscode/ripgrep": "^1.18.0",
    "fast-glob": "^3.3.3",
    "p-limit": "^7.3.0",
    "picomatch": "^4.0.5",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^25.6.0",
    "@types/picomatch": "^4.0.3",
    "knip": "^5.83.1",
    "pmd-bin": "^2.20.0",
    "repomix": "^1.14.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "homepage": "https://github.com/BaryshevRS/codelore#readme",
  "bugs": {
    "url": "https://github.com/BaryshevRS/codelore/issues"
  }
}
